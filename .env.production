# ==================== 生产环境配置 ====================
# 数据库配置（部署时修改为实际值）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gaokongche
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DB=gaokongche

# JWT 认证配置（必须修改为强密码）
JWT_SECRET=CHANGE_THIS_TO_STRONG_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# 服务器配置
API_PORT=3001
NODE_ENV=production
LOG_LEVEL=warn

# CORS 跨域配置（修改为实际域名）
ALLOWED_ORIGINS=https://your-domain.com,http://your-domain.com

# 速率限制配置（生产环境更严格）
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10

# 文件上传配置
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./server/uploads
SECURE_UPLOAD_DIR=./server/secure_uploads

# OCR 服务配置
PADDLE_OCR_URL=http://localhost:5000
