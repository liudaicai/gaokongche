# ============================================
# 高空车租赁管理系统 - 环境变量配置模板
# ============================================
# 复制此文件到项目根目录并重命名为 .env

# 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=gaokongche

# JWT密钥（⚠️ 生产环境必须修改！）
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARACTERS

# 服务端口
PORT=3001

# 运行环境
NODE_ENV=production

# CORS允许的前端域名（多个域名用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://your-domain.com,https://your-domain.com

# 租户模式（single=单租户，multi=多租户）
TENANT_MODE=single

# 日志级别（error, warn, info, debug）
LOG_LEVEL=info

# 文件上传配置
UPLOAD_MAX_SIZE=52428800
UPLOAD_DIR=./uploads

# OCR服务配置（可选）
OCR_SERVICE_URL=http://localhost:5000
OCR_ENABLED=false

# ============================================
# 部署后必须修改的配置
# ============================================
# 1. MYSQL_PASSWORD - MySQL数据库密码
# 2. JWT_SECRET - JWT加密密钥（生产环境必须使用强随机密钥）
# 3. ALLOWED_ORIGINS - 前端域名列表
# 
# ⚠️ 不要将 .env 文件提交到 Git 仓库！
# ============================================
